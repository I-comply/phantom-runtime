DATABASE_URL=postgresql://user:pass@host:5432/icomply
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
# Bearer token required by /api/cron/scrape (Vercel Cron sends it automatically)
CRON_SECRET=change-me
# Only for the reference receiver at /api/webhooks
ICOMPLY_WEBHOOK_SECRET=change-me-16+chars
# Dev only: allow scraping private/loopback targets
# ICOMPLY_ALLOW_PRIVATE_TARGETS=true
