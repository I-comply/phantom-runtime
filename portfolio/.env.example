# Names only. Never commit real values.
PORT=8080
HOST=127.0.0.1
# Directory of built site (default: ./dist)
PWX_DIST=
# Required for `npm run build` (production): final https origin, e.g. https://example.com
PWX_SITE_URL=
# Inquiry and counter storage (owner-only directory recommended)
PWX_INQUIRY_FILE=
PWX_METRICS_FILE=
# 1 when running behind a reverse proxy that sets X-Forwarded-For / terminates TLS
PWX_TRUST_PROXY=
PWX_BEHIND_TLS=
# Source clone root used by register/demos/diligence scripts (default /home/user/src)
PWX_SRC_ROOT=
# Chromium binary for PDF export (default /opt/pw-browsers/chromium-1194/chrome-linux/chrome)
CHROME_BIN=
