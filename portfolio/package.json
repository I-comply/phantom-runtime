{
  "name": "phantomworx-icomply-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "PhantomworX + i-Comply buyer-conversion portfolio: validated asset records, static storefront, per-asset decks/demos, inquiry service.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "register": "node scripts/build-register.mjs",
    "validate": "node scripts/validate-assets.mjs",
    "demos": "node scripts/record-demos.mjs",
    "build": "node scripts/build-site.mjs",
    "build:staging": "node scripts/build-site.mjs --staging",
    "serve": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run validate && npm test"
  }
}
