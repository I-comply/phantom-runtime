# nosem: phantom.docker.missing-user -- tmpfs mount requires SYS_ADMIN as root
FROM python:3.15-slim
RUN apt-get update && apt-get install -y --no-install-recommends bash util-linux coreutils && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY ram_engine.sh test_ram_engine.py ./
RUN chmod +x ram_engine.sh
# Requires: docker run --cap-add SYS_ADMIN (tmpfs mount)
ENTRYPOINT ["./ram_engine.sh"]
